From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: attrr <110731994+attrr@users.noreply.github.com>
Date: Wed, 11 Nov 2026 09:56:10 +0000
Subject: [PATCH] Revert "net: qrtr: resend HELLO on MHI resume"

This reverts commit 6a5719cc3ef2.

It builds on 544d85de4dc2's HELLO at endpoint registration, reverted
next; flame has no MHI remotes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 net/qrtr/af_qrtr.c | 13 -------------
 net/qrtr/mhi.c     |  9 +--------
 net/qrtr/qrtr.h    |  2 --
 3 files changed, 1 insertion(+), 23 deletions(-)

diff --git a/net/qrtr/af_qrtr.c b/net/qrtr/af_qrtr.c
index e7b3647424b8..78347c937af7 100644
--- a/net/qrtr/af_qrtr.c
+++ b/net/qrtr/af_qrtr.c
@@ -623,19 +623,6 @@ static void qrtr_hello_work(struct work_struct *work)
 	qrtr_port_put(ctrl);
 }
 
-/* Trigger the HELLO handshake after the remote has been reset, eg on resume */
-void qrtr_endpoint_hello(struct qrtr_endpoint *ep)
-{
-	struct qrtr_node *node = ep->node;
-
-	mutex_lock(&node->ep_lock);
-	node->hello_sent = false;
-	mutex_unlock(&node->ep_lock);
-
-	schedule_delayed_work(&node->say_hello, 0);
-}
-EXPORT_SYMBOL_GPL(qrtr_endpoint_hello);
-
 /**
  * qrtr_endpoint_register() - register a new endpoint
  * @ep: endpoint to register
diff --git a/net/qrtr/mhi.c b/net/qrtr/mhi.c
index e9a4bb92ce76..3990da1a65dc 100644
--- a/net/qrtr/mhi.c
+++ b/net/qrtr/mhi.c
@@ -183,7 +183,6 @@ static int __maybe_unused qcom_mhi_qrtr_pm_suspend_late(struct device *dev)
 static int __maybe_unused qcom_mhi_qrtr_pm_resume_early(struct device *dev)
 {
 	struct mhi_device *mhi_dev = container_of(dev, struct mhi_device, dev);
-	struct qrtr_mhi_dev *qdev = dev_get_drvdata(dev);
 	enum mhi_state state;
 	int rc;
 
@@ -202,13 +201,7 @@ static int __maybe_unused qcom_mhi_qrtr_pm_resume_early(struct device *dev)
 		return rc;
 	}
 
-	rc = qcom_mhi_qrtr_queue_dl_buffers(mhi_dev);
-	if (rc)
-		return rc;
-
-	qrtr_endpoint_hello(&qdev->ep);
-
-	return 0;
+	return qcom_mhi_qrtr_queue_dl_buffers(mhi_dev);
 }
 
 static const struct dev_pm_ops qcom_mhi_qrtr_pm_ops = {
diff --git a/net/qrtr/qrtr.h b/net/qrtr/qrtr.h
index de2de69a6199..3f2d28696062 100644
--- a/net/qrtr/qrtr.h
+++ b/net/qrtr/qrtr.h
@@ -27,8 +27,6 @@ int qrtr_endpoint_register(struct qrtr_endpoint *ep, unsigned int nid);
 
 void qrtr_endpoint_unregister(struct qrtr_endpoint *ep);
 
-void qrtr_endpoint_hello(struct qrtr_endpoint *ep);
-
 int qrtr_endpoint_post(struct qrtr_endpoint *ep, const void *data, size_t len);
 
 int qrtr_ns_init(void);
