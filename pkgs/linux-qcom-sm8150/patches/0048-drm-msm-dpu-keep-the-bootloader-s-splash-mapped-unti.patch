From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: attrr <110731994+attrr@users.noreply.github.com>
Date: Tue, 10 Nov 2026 16:17:30 +0000
Subject: [PATCH] drm/msm/dpu: keep the bootloader's splash mapped until the
 first commit

Flame's ABL leaves its splash on CTL0: VIG0 and VIG1 on LM0 and LM1, each
reading half of its framebuffer by physical address. sm8150's MDSS is on
arm-smmu-qcom's identity list, so that's fine until msm attaches its own
domain, which doesn't map it. With the MDP clock kept (dispcc), ABL's
scanout still runs then, and its pipes go on fetching the splash until
msm's own first frame: context faults at iova 0x9c4..., streams 0x800
and 0xc20, ten a boot (ratelimited) without this.

Map what the pipes read, read-only and at its own address, as soon as
the domain is attached, so that those fetches read the splash that's on
screen, and unmap it once msm's first commit is done. msm's own buffers
are allocated from the bottom of its VM, far below it by then. One fault
can still land between the attach and the map: arm-smmu has no page
tables for the domain before it's attached.

Not the colour-block frame at boot, though it was written for it: that
was dispcc parking the MDP clock under the scanout.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c | 67 +++++++++++++++++++++++++
 drivers/gpu/drm/msm/disp/dpu1/dpu_kms.h |  4 ++
 drivers/gpu/drm/msm/msm_iommu.c         | 15 ++++++
 drivers/gpu/drm/msm/msm_mmu.h           |  2 +
 4 files changed, 88 insertions(+)

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
index da3556eb6ecc..2ece0e49d0d4 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
@@ -52,6 +52,8 @@
 #define DPU_DEBUGFS_DIR "msm_dpu"
 #define DPU_DEBUGFS_HWMASKNAME "hw_log_mask"
 
+static void _dpu_kms_unmap_boot_fb(struct dpu_kms *dpu_kms);
+
 bool dpu_use_virtual_planes = true;
 module_param(dpu_use_virtual_planes, bool, 0);
 
@@ -486,6 +488,8 @@ static void dpu_kms_complete_commit(struct msm_kms *kms, unsigned crtc_mask)
 	for_each_crtc_mask(dpu_kms->dev, crtc, crtc_mask)
 		dpu_crtc_complete_commit(crtc);
 
+	_dpu_kms_unmap_boot_fb(dpu_kms);
+
 	DPU_ATRACE_END("kms_complete_commit");
 }
 
@@ -1094,6 +1098,7 @@ static void _dpu_kms_mmu_destroy(struct dpu_kms *dpu_kms)
 	if (!dpu_kms->base.vm)
 		return;
 
+	_dpu_kms_unmap_boot_fb(dpu_kms);
 	mmu = to_msm_vm(dpu_kms->base.vm)->mmu;
 
 	mmu->funcs->detach(mmu);
@@ -1102,15 +1107,77 @@ static void _dpu_kms_mmu_destroy(struct dpu_kms *dpu_kms)
 	dpu_kms->base.vm = NULL;
 }
 
+#define SSPP_SRC_SIZE		0x00
+#define SSPP_SRC0_ADDR		0x14
+#define SSPP_SRC_YSTRIDE0	0x24
+
+/*
+ * Flame's ABL leaves its splash on two pipes reading its framebuffer by
+ * physical address. sm8150's MDSS is on arm-smmu-qcom's identity list, so
+ * that works until msm attaches its own domain. Something then still has
+ * them fetch once more, while the DSI link comes back and before msm's own
+ * first frame: those fetches fault (iova 0x9c4..., streams 0x800 and 0xc20)
+ * and the panel shows a frame of colour blocks. Neither a CTL reset nor
+ * unstaging the pipes stops it. Map what the pipes read, read-only and at
+ * its own address, so such a fetch gets the splash on screen; until msm's
+ * first commit is done
+ */
+static void _dpu_kms_map_boot_fb(struct dpu_kms *dpu_kms, struct msm_mmu *mmu)
+{
+	const struct dpu_mdss_cfg *cat = dpu_kms->catalog;
+	u64 start = U64_MAX, end = 0;
+	void __iomem *b;
+	u32 addr, size, stride;
+	int i;
+
+	for (i = 0; i < cat->sspp_count; i++) {
+		b = dpu_kms->mmio + cat->sspp[i].base;
+		addr = readl_relaxed(b + SSPP_SRC0_ADDR);
+		size = readl_relaxed(b + SSPP_SRC_SIZE);
+		stride = readl_relaxed(b + SSPP_SRC_YSTRIDE0) & 0xffff;
+		if (!addr || !size || !stride)
+			continue;
+		start = min_t(u64, start, addr);
+		end = max_t(u64, end, (u64)addr + stride * (size >> 16));
+	}
+	if (start >= end)
+		return;
+
+	start = round_down(start, PAGE_SIZE);
+	end = round_up(end, PAGE_SIZE);
+	if (msm_iommu_map_phys(mmu, start, start, end - start, IOMMU_READ)) {
+		DRM_ERROR("failed to map the bootloader's splash\n");
+		return;
+	}
+	dpu_kms->boot_fb_iova = start;
+	dpu_kms->boot_fb_len = end - start;
+	DRM_INFO("mapped the bootloader's splash, %#llx+%#zx\n", start,
+		 dpu_kms->boot_fb_len);
+}
+
+static void _dpu_kms_unmap_boot_fb(struct dpu_kms *dpu_kms)
+{
+	struct msm_mmu *mmu;
+
+	if (!dpu_kms->boot_fb_len || !dpu_kms->base.vm)
+		return;
+
+	mmu = to_msm_vm(dpu_kms->base.vm)->mmu;
+	mmu->funcs->unmap(mmu, dpu_kms->boot_fb_iova, dpu_kms->boot_fb_len);
+	dpu_kms->boot_fb_len = 0;
+}
+
 static int _dpu_kms_mmu_init(struct dpu_kms *dpu_kms)
 {
 	struct drm_gpuvm *vm;
 
+
 	vm = msm_kms_init_vm(dpu_kms->dev, dpu_kms->dev->dev->parent);
 	if (IS_ERR(vm))
 		return PTR_ERR(vm);
 
 	dpu_kms->base.vm = vm;
+	_dpu_kms_map_boot_fb(dpu_kms, to_msm_vm(vm)->mmu);
 
 	return 0;
 }
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.h b/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.h
index e39831a397b1..e5edbe7981b3 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.h
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.h
@@ -65,6 +65,10 @@ struct dpu_kms {
 	/* io/register spaces: */
 	void __iomem *mmio, *vbif;
 
+	/* the bootloader's splash, mapped until the first commit is done */
+	u64 boot_fb_iova;
+	size_t boot_fb_len;
+
 	struct regulator *vdd;
 	struct regulator *mmagic;
 	struct regulator *venus;
diff --git a/drivers/gpu/drm/msm/msm_iommu.c b/drivers/gpu/drm/msm/msm_iommu.c
index da6782fca6bd..6a2c44ecc311 100644
--- a/drivers/gpu/drm/msm/msm_iommu.c
+++ b/drivers/gpu/drm/msm/msm_iommu.c
@@ -704,6 +704,21 @@ static int msm_iommu_map(struct msm_mmu *mmu, uint64_t iova,
 	return (ret == len) ? 0 : -EINVAL;
 }
 
+/*
+ * Map memory the kernel doesn't (a bootloader's no-map framebuffer, say) at
+ * an iova, outside of any GEM object
+ */
+int msm_iommu_map_phys(struct msm_mmu *mmu, uint64_t iova, phys_addr_t pa,
+		       size_t len, int prot)
+{
+	struct msm_iommu *iommu = to_msm_iommu(mmu);
+
+	if (iova & BIT_ULL(48))
+		iova |= GENMASK_ULL(63, 49);
+
+	return iommu_map(iommu->domain, iova, pa, len, prot, GFP_KERNEL);
+}
+
 static int msm_iommu_unmap(struct msm_mmu *mmu, uint64_t iova, size_t len)
 {
 	struct msm_iommu *iommu = to_msm_iommu(mmu);
diff --git a/drivers/gpu/drm/msm/msm_mmu.h b/drivers/gpu/drm/msm/msm_mmu.h
index 8915662fbd4d..428b682c1adf 100644
--- a/drivers/gpu/drm/msm/msm_mmu.h
+++ b/drivers/gpu/drm/msm/msm_mmu.h
@@ -77,6 +77,8 @@ static inline void msm_mmu_init(struct msm_mmu *mmu, struct device *dev,
 struct msm_mmu *msm_iommu_new(struct device *dev, unsigned long quirks);
 struct msm_mmu *msm_iommu_gpu_new(struct device *dev, struct msm_gpu *gpu, unsigned long quirks);
 struct msm_mmu *msm_iommu_disp_new(struct device *dev, unsigned long quirks);
+int msm_iommu_map_phys(struct msm_mmu *mmu, uint64_t iova, phys_addr_t pa,
+		       size_t len, int prot);
 
 static inline void msm_mmu_set_fault_handler(struct msm_mmu *mmu, void *arg,
 		int (*handler)(void *arg, unsigned long iova, int flags, void *data))
