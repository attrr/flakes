From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: attrr <110731994+attrr@users.noreply.github.com>
Date: Mon, 9 Nov 2026 15:27:00 +0000
Subject: [PATCH] drm/msm/dsi: say which timeout and fifo errors the error
 worker found

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/msm/dsi/dsi_host.c | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index db6da99375a1..e948bca5aa8a 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -147,6 +147,8 @@ struct msm_dsi_host {
 	spinlock_t intr_lock; /* Protect interrupt ctrl register */
 
 	u32 err_work_state;
+	u32 err_timeout_status;
+	u32 err_fifo_status;
 	struct work_struct err_work;
 	struct workqueue_struct *workqueue;
 
@@ -1552,12 +1554,16 @@ static void dsi_err_worker(struct work_struct *work)
 		container_of(work, struct msm_dsi_host, err_work);
 	u32 status = msm_host->err_work_state;
 
-	pr_err_ratelimited("%s: status=%x\n", __func__, status);
+	pr_err_ratelimited("%s: status=%x timeout=%x fifo=%x\n", __func__,
+			   status, msm_host->err_timeout_status,
+			   msm_host->err_fifo_status);
 	if (status & DSI_ERR_STATE_MDP_FIFO_UNDERFLOW)
 		dsi_sw_reset(msm_host);
 
 	/* It is safe to clear here because error irq is disabled. */
 	msm_host->err_work_state = 0;
+	msm_host->err_timeout_status = 0;
+	msm_host->err_fifo_status = 0;
 
 	/* enable dsi error interrupt */
 	dsi_intr_ctrl(msm_host, DSI_IRQ_MASK_ERROR, 1);
@@ -1584,6 +1590,7 @@ static void dsi_timeout_status(struct msm_dsi_host *msm_host)
 	status = dsi_read(msm_host, REG_DSI_TIMEOUT_STATUS);
 
 	if (status) {
+		msm_host->err_timeout_status |= status;
 		dsi_write(msm_host, REG_DSI_TIMEOUT_STATUS, status);
 		msm_host->err_work_state |= DSI_ERR_STATE_TIMEOUT;
 	}
@@ -1613,6 +1620,7 @@ static void dsi_fifo_status(struct msm_dsi_host *msm_host)
 
 	/* fifo underflow, overflow */
 	if (status) {
+		msm_host->err_fifo_status |= status;
 		dsi_write(msm_host, REG_DSI_FIFO_STATUS, status);
 		msm_host->err_work_state |= DSI_ERR_STATE_FIFO;
 		if (status & DSI_FIFO_STATUS_CMD_MDP_FIFO_UNDERFLOW)
