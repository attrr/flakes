From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: attrr <110731994+attrr@users.noreply.github.com>
Date: Mon, 9 Nov 2026 15:27:01 +0000
Subject: [PATCH] power: supply: qcom_smbx: input current from Type-C

What BC1.2 detection sets the input limit by isn't all a source can
say: take a PD contract's current, or Rp's, from a supplying Type-C
port as it changes, up to the 3A a 5V sink takes, and back to an SDP's
500mA on unplug. SMB5 only goes by a limit it's given past APSD with
ICL_OVERRIDE_AFTER_APSD, in USBIN_LOAD_CFG at 0x365, not 0x65.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/power/supply/qcom_smbx.c | 55 ++++++++++++++++++++++++++------
 1 file changed, 45 insertions(+), 10 deletions(-)

diff --git a/drivers/power/supply/qcom_smbx.c b/drivers/power/supply/qcom_smbx.c
index ba59008b106f..b79b2d5344d2 100644
--- a/drivers/power/supply/qcom_smbx.c
+++ b/drivers/power/supply/qcom_smbx.c
@@ -109,7 +109,7 @@ enum smb_generation {
 #define AUTO_SRC_DETECT_BIT				BIT(3)
 #define HVDCP_EN_BIT					BIT(2)
 
-#define USBIN_LOAD_CFG					0x65
+#define USBIN_LOAD_CFG					0x365
 #define ICL_OVERRIDE_AFTER_APSD_BIT			BIT(4)
 
 #define USBIN_ICL_OPTIONS				0x366
@@ -196,6 +196,8 @@ enum smb_generation {
 #define CDP_CURRENT_UA					1500000
 #define DCP_CURRENT_UA					1500000
 #define CURRENT_MAX_UA					DCP_CURRENT_UA
+/* what a sink at 5V takes from Type-C, PD contract or Rp */
+#define TYPEC_CURRENT_MAX_UA				3000000
 
 /* pmi8998 registers represent current in increments of 1/40th of an amp */
 #define CURRENT_SCALE_FACTOR				25000
@@ -453,6 +455,7 @@ static inline int smb_get_current_limit(struct smb_chip *chip,
 static int smb_set_current_limit(struct smb_chip *chip, unsigned int val)
 {
 	unsigned char val_raw;
+	int rc;
 
 	if (val > 4800000) {
 		dev_err(chip->dev,
@@ -461,12 +464,24 @@ static int smb_set_current_limit(struct smb_chip *chip, unsigned int val)
 	}
 	val_raw = val / CURRENT_SCALE_FACTOR;
 
-	return regmap_write(chip->regmap, chip->base + USBIN_CURRENT_LIMIT_CFG,
-			    val_raw);
+	rc = regmap_write(chip->regmap, chip->base + USBIN_CURRENT_LIMIT_CFG,
+			  val_raw);
+	if (rc < 0 || chip->gen != SMB5)
+		return rc;
+
+	/*
+	 * SMB5 keeps to the limit it found by APSD unless told to take this
+	 * one after it, as downstream does above an SDP's 500mA
+	 */
+	return regmap_update_bits(chip->regmap, chip->base + USBIN_LOAD_CFG,
+				  ICL_OVERRIDE_AFTER_APSD_BIT,
+				  val > SDP_CURRENT_UA ?
+				  ICL_OVERRIDE_AFTER_APSD_BIT : 0);
 }
 
 static void smb_status_change_work(struct work_struct *work)
 {
+	union power_supply_propval typec_ua;
 	unsigned int charger_type, current_ua;
 	int usb_online = 0;
 	int count, rc;
@@ -475,8 +490,11 @@ static void smb_status_change_work(struct work_struct *work)
 	chip = container_of(work, struct smb_chip, status_change_work.work);
 
 	smb_get_prop_usb_online(chip, &usb_online);
-	if (!usb_online)
+	if (!usb_online) {
+		/* not to start the next plug-in at this one's limit */
+		smb_set_current_limit(chip, SDP_CURRENT_UA);
 		return;
+	}
 
 	for (count = 0; count < 3; count++) {
 		dev_dbg(chip->dev, "get charger type retry %d\n", count);
@@ -513,6 +531,13 @@ static void smb_status_change_work(struct work_struct *work)
 		break;
 	}
 
+	/* A source saying more for itself, by PD or Rp, has the last word */
+	if (!power_supply_get_property_from_supplier(chip->chg_psy,
+						     POWER_SUPPLY_PROP_CURRENT_MAX,
+						     &typec_ua) &&
+	    typec_ua.intval > 0)
+		current_ua = min(typec_ua.intval, TYPEC_CURRENT_MAX_UA);
+
 	smb_set_current_limit(chip, current_ua);
 	power_supply_changed(chip->chg_psy);
 }
@@ -806,6 +831,15 @@ static irqreturn_t smb_handle_wdog_bark(int irq, void *data)
 	return IRQ_HANDLED;
 }
 
+static void smb_external_power_changed(struct power_supply *psy)
+{
+	struct smb_chip *chip = power_supply_get_drvdata(psy);
+
+	/* not before it has the battery's info, which the work reads */
+	if (chip->batt_info)
+		schedule_delayed_work(&chip->status_change_work, 0);
+}
+
 static const struct power_supply_desc smb_psy_desc = {
 	.name = "SMB2_charger",
 	.type = POWER_SUPPLY_TYPE_USB,
@@ -821,6 +855,7 @@ static const struct power_supply_desc smb_psy_desc = {
 	.get_property = smb_get_property,
 	.set_property = smb_set_property,
 	.property_is_writeable = smb_property_is_writable,
+	.external_power_changed = smb_external_power_changed,
 };
 
 /* Init sequence derived from vendor downstream driver */
@@ -1130,6 +1165,12 @@ static int smb_probe(struct platform_device *pdev)
 	if (!desc->name)
 		return -ENOMEM;
 
+	rc = devm_delayed_work_autocancel(chip->dev, &chip->status_change_work,
+					  smb_status_change_work);
+	if (rc)
+		return dev_err_probe(chip->dev, rc,
+				     "Failed to init status change work\n");
+
 	chip->chg_psy =
 		devm_power_supply_register(chip->dev, desc, &supply_config);
 	if (IS_ERR(chip->chg_psy))
@@ -1143,12 +1184,6 @@ static int smb_probe(struct platform_device *pdev)
 	if (chip->batt_info->constant_charge_current_max_ua == -EINVAL)
 		chip->batt_info->constant_charge_current_max_ua = DCP_CURRENT_UA;
 
-	rc = devm_delayed_work_autocancel(chip->dev, &chip->status_change_work,
-					  smb_status_change_work);
-	if (rc)
-		return dev_err_probe(chip->dev, rc,
-				     "Failed to init status change work\n");
-
 	rc = (chip->batt_info->voltage_max_design_uv - 3487500) / 7500 + 1;
 	rc = regmap_update_bits(chip->regmap, chip->base + FLOAT_VOLTAGE_CFG,
 				FLOAT_VOLTAGE_SETTING_MASK, rc);
