From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: attrr <110731994+attrr@users.noreply.github.com>
Date: Mon, 9 Nov 2026 17:46:09 +0000
Subject: [PATCH] Input: touchscreen: fts_touch: the screen's state from the
 panel

The vendor kernel dropped the screen's reference on the touch bus from
its display notifier, which this port comments out: the reference taken
at probe stayed, and the driver refused every system suspend ("can't
suspend because touch bus is in use!"). Follow the panel instead, its
reference from prepare to unprepare, and point flame's touchscreen at
it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/qcom/sm8150-google-flame.dts     |  3 +-
 drivers/input/touchscreen/fts_touch/fts.c     | 49 +++++++++++++++++--
 drivers/input/touchscreen/fts_touch/fts.h     |  1 +
 3 files changed, 49 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8150-google-flame.dts b/arch/arm64/boot/dts/qcom/sm8150-google-flame.dts
index a2919efe98da..50bf18b97b6a 100644
--- a/arch/arm64/boot/dts/qcom/sm8150-google-flame.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-google-flame.dts
@@ -1241,7 +1241,7 @@ &mdss_dsi0 {
 	status = "okay";
 	vdda-supply = <&vreg_l3c_1p2>;
 	
-	panel@0 {
+	panel: panel@0 {
 		compatible = "lg,nt37280-lh568wf3-ed01";
 		reg = <0>;
 		
@@ -1320,6 +1320,7 @@ touchscreen: touchscreen@0 {
 		st,regulator_dvdd = "vdd";
 		st,regulator_avdd = "avdd";
 		st,max-coords = <1079 2279>;
+		panel = <&panel>;
 
 		firmware-name = "ftm5_fw.ftb";
 	};
diff --git a/drivers/input/touchscreen/fts_touch/fts.c b/drivers/input/touchscreen/fts_touch/fts.c
index d863beeb2c27..b8aadea96f21 100644
--- a/drivers/input/touchscreen/fts_touch/fts.c
+++ b/drivers/input/touchscreen/fts_touch/fts.c
@@ -4928,6 +4928,31 @@ int fts_set_bus_ref(struct fts_ts_info *info, u16 ref, bool enable)
 	return result;
 }
 
+/* As the notifier below did with the vendor kernel's display: the screen's
+ * reference on the bus for as long as the panel is powered */
+static int fts_panel_prepared(struct drm_panel_follower *follower)
+{
+	struct fts_ts_info *info = container_of(follower, struct fts_ts_info,
+						panel_follower);
+
+	fts_set_bus_ref(info, FTS_BUS_REF_SCREEN_ON, true);
+	return 0;
+}
+
+static int fts_panel_unpreparing(struct drm_panel_follower *follower)
+{
+	struct fts_ts_info *info = container_of(follower, struct fts_ts_info,
+						panel_follower);
+
+	fts_set_bus_ref(info, FTS_BUS_REF_SCREEN_ON, false);
+	return 0;
+}
+
+static const struct drm_panel_follower_funcs fts_panel_follower_funcs = {
+	.panel_prepared = fts_panel_prepared,
+	.panel_unpreparing = fts_panel_unpreparing,
+};
+
 // /**
 //   * Callback function used to detect the suspend/resume events generated by
 //   * clicking the power button.
@@ -5631,6 +5656,17 @@ static int fts_probe(struct spi_device *client)
 	touch_offload_init(&info->offload);
 #endif
 
+	/* The screen's reference, assumed during probe, from the panel: if
+	 * it's off, the screen's reference goes */
+	if (drm_is_panel_follower(info->dev)) {
+		info->panel_follower.funcs = &fts_panel_follower_funcs;
+		error = drm_panel_add_follower(info->dev, &info->panel_follower);
+		if (error)
+			goto ProbeErrorExit_7;
+		if (!info->panel_follower.panel->prepared)
+			fts_set_bus_ref(info, FTS_BUS_REF_SCREEN_ON, false);
+	}
+
 #if defined(FW_UPDATE_ON_PROBE) && defined(FW_H_FILE)
 	pr_info("FW Update and Sensing Initialization:\n");
 	error = fts_fw_update(info);
@@ -5638,7 +5674,7 @@ static int fts_probe(struct spi_device *client)
 		pr_err("Cannot execute fw upgrade the device ERROR %08X\n",
 			error);
 		error = -ENODEV;
-		goto ProbeErrorExit_7;
+		goto ProbeErrorExit_8;
 	}
 
 #else
@@ -5648,7 +5684,7 @@ static int fts_probe(struct spi_device *client)
 					      WQ_CPU_INTENSIVE, 1);
 	if (!info->fwu_workqueue) {
 		pr_err("ERROR: Cannot create fwu work thread\n");
-		goto ProbeErrorExit_7;
+		goto ProbeErrorExit_8;
 	}
 	INIT_DELAYED_WORK(&info->fwu_work, fts_fw_update_auto);
 #endif
@@ -5660,7 +5696,7 @@ static int fts_probe(struct spi_device *client)
 	if (error) {
 		pr_err("ERROR: Cannot create sysfs structure!\n");
 		error = -ENODEV;
-		goto ProbeErrorExit_7;
+		goto ProbeErrorExit_8;
 	}
 
 	error = fts_proc_init();
@@ -5685,6 +5721,10 @@ static int fts_probe(struct spi_device *client)
 	return OK;
 
 
+ProbeErrorExit_8:
+	if (info->panel_follower.panel)
+		drm_panel_remove_follower(&info->panel_follower);
+
 ProbeErrorExit_7:
 	if(info->touchsim.wq)
 		destroy_workqueue(info->touchsim.wq);
@@ -5752,6 +5792,9 @@ static void fts_remove(struct spi_device *client)
 	tbn_cleanup(info->tbn);
 #endif
 
+	if (info->panel_follower.panel)
+		drm_panel_remove_follower(&info->panel_follower);
+
 	fts_proc_remove();
 
 	/* sysfs stuff */
diff --git a/drivers/input/touchscreen/fts_touch/fts.h b/drivers/input/touchscreen/fts_touch/fts.h
index 4459782f380c..8c97b5f8c21d 100644
--- a/drivers/input/touchscreen/fts_touch/fts.h
+++ b/drivers/input/touchscreen/fts_touch/fts.h
@@ -445,6 +445,7 @@ struct fts_ts_info {
 	struct fts_disp_extinfo extinfo;	/* Display extended info */
 
 	struct notifier_block notifier;	/* Notify on suspend/resume */
+	struct drm_panel_follower panel_follower; /* The screen's state */
 	int display_refresh_rate;	/* Display rate in Hz */
 	bool sensor_sleep;		/* True if suspend called */
 	struct wakeup_source *wakesrc;	/* Wake Lock struct */
