From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: attrr <110731994+attrr@users.noreply.github.com>
Date: Mon, 9 Nov 2026 16:49:10 +0000
Subject: [PATCH] power: supply: qcom_smbx: the charger as a cooling device

Stock throttles charging from the phone's temperature, its
google_charger a cooling device of google,thermal-mitigation's charge
currents, and cuts USB input when the port overheats, its
overheat_mitigation. Be one cooling device for both: each state from 1
a charge current under the charge table's, or with 0 USB_IN suspended,
applied through the table's poll as the state changes. USB_IN's suspend
by it and by charge_behaviour (or the status property) are kept apart,
as charging's inhibits are, so neither undoes the other.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/power/supply/qcom_smbx.c | 157 +++++++++++++++++++++++++++----
 1 file changed, 140 insertions(+), 17 deletions(-)

diff --git a/drivers/power/supply/qcom_smbx.c b/drivers/power/supply/qcom_smbx.c
index d1b7a014a12a..f987dd6e8087 100644
--- a/drivers/power/supply/qcom_smbx.c
+++ b/drivers/power/supply/qcom_smbx.c
@@ -23,6 +23,7 @@
 #include <linux/property.h>
 #include <linux/regmap.h>
 #include <linux/string.h>
+#include <linux/thermal.h>
 #include <linux/types.h>
 #include <linux/workqueue.h>
 
@@ -270,9 +271,16 @@ struct smb_init_register {
  * @usb_in_i_chan:	USB_IN current measurement channel
  * @usb_in_v_chan:	USB_IN voltage measurement channel
  * @chg_psy:		Charger power supply instance
- * @lock:		Serialises the charging enable's two inhibits
+ * @lock:		Serialises the charging enable's two inhibits, and USBIN's
+ *			two suspends
  * @user_inhibit:	Charging inhibited by charge_behaviour
  * @table_inhibit:	Charging inhibited by the charge table
+ * @user_suspend:	USBIN suspended by charge_behaviour
+ * @therm_suspend:	USBIN suspended by the cooling device
+ * @therm_limits:	The cooling device's charge currents, from state 1; 0
+ *			suspends USBIN
+ * @n_therm:		The number of @therm_limits, its maximum state
+ * @therm_state:	The cooling device's state
  * @table_work:		The charge table's poll
  * @temp_limits:	The table's temperatures, in tenths of a degree C
  * @volt_limits:	Its tiers' float voltages
@@ -306,6 +314,12 @@ struct smb_chip {
 	struct mutex lock;
 	bool user_inhibit;
 	bool table_inhibit;
+	bool user_suspend;
+	bool therm_suspend;
+
+	int *therm_limits;
+	int n_therm;
+	unsigned long therm_state;
 
 	struct delayed_work table_work;
 	int *temp_limits;
@@ -652,17 +666,21 @@ static int smb_update_charging_enable(struct smb_chip *chip)
  * battery only makes up what the input limit can't; suspending USB_IN runs
  * it from the battery alone
  */
-static int smb_get_charge_behaviour(struct smb_chip *chip, int *val)
+/* USB_IN is suspended if charge_behaviour or the cooling device suspend it */
+static int smb_update_usbin_suspend(struct smb_chip *chip)
 {
-	unsigned int suspend;
-	int rc;
+	lockdep_assert_held(&chip->lock);
 
-	rc = regmap_read(chip->regmap, chip->base + USBIN_CMD_IL, &suspend);
-	if (rc < 0)
-		return rc;
+	return regmap_update_bits(chip->regmap, chip->base + USBIN_CMD_IL,
+				  USBIN_SUSPEND_BIT,
+				  chip->user_suspend || chip->therm_suspend ?
+				  USBIN_SUSPEND_BIT : 0);
+}
 
-	/* charge_behaviour's own inhibit, not the charge table's */
-	if (suspend & USBIN_SUSPEND_BIT)
+static int smb_get_charge_behaviour(struct smb_chip *chip, int *val)
+{
+	/* charge_behaviour's own, not the charge table's or cooling's */
+	if (READ_ONCE(chip->user_suspend))
 		*val = POWER_SUPPLY_CHARGE_BEHAVIOUR_FORCE_DISCHARGE;
 	else if (READ_ONCE(chip->user_inhibit))
 		*val = POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE;
@@ -683,15 +701,17 @@ static int smb_set_charge_behaviour(struct smb_chip *chip, int val)
 		WRITE_ONCE(chip->user_inhibit,
 			   val == POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE);
 		rc = smb_update_charging_enable(chip);
+		if (!rc) {
+			WRITE_ONCE(chip->user_suspend, false);
+			rc = smb_update_usbin_suspend(chip);
+		}
 		mutex_unlock(&chip->lock);
-		if (rc < 0)
-			return rc;
-		rc = regmap_update_bits(chip->regmap, chip->base + USBIN_CMD_IL,
-					USBIN_SUSPEND_BIT, 0);
 		break;
 	case POWER_SUPPLY_CHARGE_BEHAVIOUR_FORCE_DISCHARGE:
-		rc = regmap_update_bits(chip->regmap, chip->base + USBIN_CMD_IL,
-					USBIN_SUSPEND_BIT, USBIN_SUSPEND_BIT);
+		mutex_lock(&chip->lock);
+		WRITE_ONCE(chip->user_suspend, true);
+		rc = smb_update_usbin_suspend(chip);
+		mutex_unlock(&chip->lock);
 		break;
 	default:
 		return -EINVAL;
@@ -814,9 +834,21 @@ static void smb_table_work(struct work_struct *work)
 	int health = POWER_SUPPLY_HEALTH_GOOD;
 	int fcc = chip->fcc_ua, fv = chip->fv_uv;
 	int t = chip->temp_idx, v = chip->volt_idx;
+	unsigned long state = READ_ONCE(chip->therm_state);
+	int therm_ua = state ? chip->therm_limits[state - 1] : 0;
 	int usb_online = 0;
 	bool inhibit = false, changed;
 
+	/* first: suspended, USBIN isn't online */
+	mutex_lock(&chip->lock);
+	if (chip->therm_suspend != (state && !therm_ua)) {
+		chip->therm_suspend = state && !therm_ua;
+		dev_info(chip->dev, "cooling: USB input %s\n",
+			 chip->therm_suspend ? "suspended" : "resumed");
+	}
+	smb_update_usbin_suspend(chip);
+	mutex_unlock(&chip->lock);
+
 	smb_get_prop_usb_online(chip, &usb_online);
 	if (!usb_online) {
 		/* the next plug-in seeds it again */
@@ -864,6 +896,8 @@ static void smb_table_work(struct work_struct *work)
 		fv = chip->volt_limits[v];
 		inhibit = !fcc;
 	}
+	if (therm_ua)
+		fcc = min(fcc, therm_ua);
 
 	if (t != chip->temp_idx || v != chip->volt_idx) {
 		chip->switch_cnt = 0;
@@ -951,6 +985,87 @@ static int smb_read_table(struct smb_chip *chip)
 	return 0;
 }
 
+static int smb_cooling_get_max_state(struct thermal_cooling_device *cdev,
+				     unsigned long *state)
+{
+	struct smb_chip *chip = cdev->devdata;
+
+	*state = chip->n_therm;
+	return 0;
+}
+
+static int smb_cooling_get_cur_state(struct thermal_cooling_device *cdev,
+				     unsigned long *state)
+{
+	struct smb_chip *chip = cdev->devdata;
+
+	*state = READ_ONCE(chip->therm_state);
+	return 0;
+}
+
+static int smb_cooling_set_cur_state(struct thermal_cooling_device *cdev,
+				     unsigned long state)
+{
+	struct smb_chip *chip = cdev->devdata;
+
+	if (state > chip->n_therm)
+		return -EINVAL;
+	if (state == READ_ONCE(chip->therm_state))
+		return 0;
+
+	WRITE_ONCE(chip->therm_state, state);
+	dev_info(chip->dev, "cooling: state %lu\n", state);
+	mod_delayed_work(system_wq, &chip->table_work, 0);
+	return 0;
+}
+
+static const struct thermal_cooling_device_ops smb_cooling_ops = {
+	.get_max_state = smb_cooling_get_max_state,
+	.get_cur_state = smb_cooling_get_cur_state,
+	.set_cur_state = smb_cooling_set_cur_state,
+};
+
+/*
+ * The charger as a cooling device, as stock's google_charger: each state
+ * from 1 a charge current (google,thermal-mitigation) under the charge
+ * table's, or 0 for none from USB_IN at all, as stock's overheat_mitigation
+ * for a hot port. Through the charge table's poll, so with one only
+ */
+static int smb_register_cooling(struct smb_chip *chip)
+{
+	struct device *dev = chip->dev;
+	struct thermal_cooling_device *cdev;
+	int n, i;
+
+	if (!device_property_present(dev, "google,thermal-mitigation"))
+		return 0;
+
+	n = device_property_count_u32(dev, "google,thermal-mitigation");
+	if (n < 1 || !chip->n_temps)
+		return dev_err_probe(dev, -EINVAL,
+				     "Thermal mitigation needs a charge table\n");
+
+	chip->therm_limits = devm_kcalloc(dev, n, sizeof(int), GFP_KERNEL);
+	if (!chip->therm_limits)
+		return -ENOMEM;
+	device_property_read_u32_array(dev, "google,thermal-mitigation",
+				       (u32 *)chip->therm_limits, n);
+	for (i = 0; i < n; i++)
+		if (chip->therm_limits[i] < 0)
+			return dev_err_probe(dev, -EINVAL,
+					     "Thermal mitigation current under 0\n");
+	chip->n_therm = n;
+
+	cdev = devm_thermal_of_cooling_device_register(dev, 0,
+						       chip->chg_psy->desc->name,
+						       chip, &smb_cooling_ops);
+	if (IS_ERR(cdev))
+		return dev_err_probe(dev, PTR_ERR(cdev),
+				     "Couldn't register cooling device\n");
+
+	return 0;
+}
+
 static int smb_get_iio_chan(struct smb_chip *chip, struct iio_channel *chan,
 			     int *val)
 {
@@ -1109,11 +1224,15 @@ static int smb_set_property(struct power_supply *psy,
 			     const union power_supply_propval *val)
 {
 	struct smb_chip *chip = power_supply_get_drvdata(psy);
+	int ret;
 
 	switch (psp) {
 	case POWER_SUPPLY_PROP_STATUS:
-		return regmap_update_bits(chip->regmap, chip->base + USBIN_CMD_IL,
-					  USBIN_SUSPEND_BIT, !val->intval);
+		mutex_lock(&chip->lock);
+		WRITE_ONCE(chip->user_suspend, !val->intval);
+		ret = smb_update_usbin_suspend(chip);
+		mutex_unlock(&chip->lock);
+		return ret;
 	case POWER_SUPPLY_PROP_CURRENT_MAX:
 		return smb_set_current_limit(chip, val->intval);
 	case POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR:
@@ -1570,6 +1689,10 @@ static int smb_probe(struct platform_device *pdev)
 	if (rc < 0)
 		return rc;
 
+	rc = smb_register_cooling(chip);
+	if (rc < 0)
+		return rc;
+
 	/*
 	 * With a charge table, its first tier's voltage at its fallback current
 	 * until its first poll. Without, a relatively safe current while still
