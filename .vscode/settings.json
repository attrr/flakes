{
    "nix.serverSettings": {
        "nixd": {
            "nixpkgs": {
                "expr": "import <nixpkgs> { }"
            },
            "options": {
                "nixos": {
                    "expr": "(import ./eval-modules.nix).nixos"
                },
                "home-manager": {
                    "expr": "(import ./eval-modules.nix).home-manager"
                },
                "custom": {
                    "expr": "(import ./eval-modules.nix).custom"
                },
                "finix": {
                    "expr": "(import ./eval-modules.nix).finix"
                },
                "ctx": {
                    "expr": "(import ./eval-modules.nix).ctx"
                },
                "aspect": {
                    "expr": "(import ./eval-modules.nix).aspect"
                }
            }
        }
    }
}
