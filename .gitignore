# Ignore all, Unignore file with extensions, Unignore dirs
*
!*.*
!*/

Makefile
# Ignore tempdir
**/dist
**/build

# containers
!**/Dockerfile
!**/Containerfile
!tests

# python
__pycache__/
*.py[cod]

# ignore disk files and potentially any zip files
*.raw
*.raw.zst
*.raw.gz
*.qcow2
*.rar
*.zip
*.img

# zsh's fmt Makefile
!home/foo/zsh/Makefile
